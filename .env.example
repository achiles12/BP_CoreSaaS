# =============================================================================
# Core SaaS scaffold: environment settings
# Optional: the stack runs without a .env. Copy to .env (`make env`) to change
# something. Every value here is a SAFE DEV DEFAULT. See README_CLONING.md.
# Never commit .env. Production values come from Docker secrets / a real .env.
# =============================================================================

# --- This clone (change these for a second clone on the same machine) --------
# Containers, network and volumes are named after it. Default: the folder name.
# A NEW name means new, EMPTY volumes.
# COMPOSE_PROJECT_NAME=acme
# Host used in email links, upload URLs and CORS. Use this machine's LAN IP to
# open the app from another PC.
PUBLIC_HOST=localhost
# Demo org + one user per role on `up` (only with APP_ENV=dev).
SEED_DEMO=true

# --- Application -------------------------------------------------------------
APP_ENV=dev                         # dev | test | prod
SECRET_KEY=dev-only-change-me       # CHANGE ME outside dev: signs JWTs (min 32 chars in prod)
# Derived from PUBLIC_HOST and the ports; set only to override:
# FRONTEND_URL=http://localhost:3200
# CORS_ORIGINS=http://localhost:3200
TENANT_HEADER=X-Tenant              # header carrying the org slug

# --- Auth --------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false                 # true when served over HTTPS
# Cookie names start with this; default "<project>_". Empty = plain names.
# COOKIE_PREFIX=acme_
REQUIRE_EMAIL_VERIFICATION=true
REFRESH_COOKIE_PATH=/api/auth      # refresh cookie scope (browser path via the Next.js proxy)
AUTH_RATE_LIMIT_PER_MINUTE=5       # login/forgot/reset per IP+email
APP_NAME=Core SaaS                 # product name used in emails

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Containers reach Postgres at postgres:5432. DATABASE_URL is assembled in
# docker-compose.yml from the three values above; set it here only to override.
# DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app

# --- Redis (internal only, not published to the host) ------------------------
# REDIS_URL=redis://redis:6379/0    # fixed in docker-compose.yml

# --- Email (Mailpit in dev: no auth, no TLS) ---------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@app.local

# --- Object storage (RustFS, S3-compatible; replaces MinIO) ------------------
# RustFS root credentials (also used by the backend). These are also the
# RustFS console login. Comments stay on their own lines so the values can be
# copied without trailing spaces. CHANGE BOTH outside dev.
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey-change-me
S3_BUCKET=app-files
# S3_ENDPOINT=http://rustfs:9000    # fixed in docker-compose.yml (container network)
# Browser-facing endpoint for presigned URLs (they are signed for this host). Use the server's LAN IP when
# testing from another machine (or just set PUBLIC_HOST).
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_MB=50
# Comma-separated MIME types accepted for upload (B05 D4). Empty = the built-in
# default list (PDF, images, text/CSV, zip, Office).
# ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg
EXPORT_MAX_ROWS=100000
# Export files are deleted after this many days (0 = keep forever, B07 D2).
EXPORT_RETENTION_DAYS=7
# Daily export cleanup time, UTC (default 03:45, after file cleanup at 03:30).
EXPORT_CLEANUP_HOUR=3
EXPORT_CLEANUP_MINUTE=45

# --- Audit -------------------------------------------------------------------
# AUDIT_LOG_DIR=/var/log/app/audit  # fixed in docker-compose.yml; host dir is ./logs/audit

# --- Host ports (published on all interfaces, reachable from the LAN) --------
# No comments after the values. `make ports` shows which are free.
# Example for a second clone: 3300, 8300, 5300, 9300, 9301, 1325, 8325
# POSTGRES_HOST_PORT is for DBeaver. SMTP_PORT above is the port inside the
# network and stays 1025.
FRONTEND_PORT=3200
BACKEND_PORT=8200
POSTGRES_HOST_PORT=5200
S3_API_PORT=9000
S3_CONSOLE_PORT=9201
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
